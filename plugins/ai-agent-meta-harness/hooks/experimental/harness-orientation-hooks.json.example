{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AI_AGENT_META_HARNESS_PLUGIN_ROOT}/hooks/experimental/harness_orientation.py\" --session-start",
            "timeout": 5,
            "statusMessage": "Loading meta-harness orientation"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AI_AGENT_META_HARNESS_PLUGIN_ROOT}/hooks/experimental/harness_orientation.py\" --user-prompt-submit",
            "timeout": 5,
            "statusMessage": "Tracking meta-harness mode"
          }
        ]
      }
    ]
  }
}
