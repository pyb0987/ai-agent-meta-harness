#!/usr/bin/env python3
"""Public governance CLI wrapper for the repository-local v2 checker."""

from __future__ import annotations

from pathlib import Path
import os
import sys


def main() -> None:
    checker = Path(__file__).resolve().parent / "scripts" / "check-governance-acceptance.py"
    os.execv(sys.executable, [sys.executable, str(checker), *sys.argv[1:]])


if __name__ == "__main__":
    main()
